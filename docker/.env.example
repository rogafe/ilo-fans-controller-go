# Self-hosting environment file for docker/docker-compose.yml
# Never commit real credentials. Rotate credentials immediately if exposed.

APP_PORT=3000
ENV=production

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=ilo_fans_controller
DB_SSLMODE=disable

ILO_HOST=your-ilo-host-or-ip
ILO_USERNAME=your-ilo-username
ILO_PASSWORD=your-ilo-password

# Optional SSH compatibility overrides for older iLO firmware
ILO_SSH_KEX_ALGORITHMS=diffie-hellman-group14-sha1
ILO_SSH_HOST_KEY_ALGORITHMS=ssh-rsa
ILO_SSH_PUBKEY_ACCEPTED_ALGORITHMS=ssh-rsa
ILO_SSH_CIPHERS=aes256-ctr
ILO_SSH_MACS=hmac-sha2-256

ILO_SNMP_HOST=your-ilo-host-or-ip
ILO_SNMP_PORT=161
ILO_SNMP_COMMUNITY=public
ILO_SNMP_VERSION=2c
ILO_SNMP_TIMEOUT_SECONDS=5
ILO_SNMP_RETRIES=1

MINIMUM_FAN_SPEED=10
FAN_APPLY_TIMEOUT_SECONDS=30
FAN_APPLY_TOLERANCE=2
ILO_INSECURE_TLS=true
